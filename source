    // =========================================================
    // LOCAL PLAYER
    // =========================================================

    private object GetLocalPlayer()
    {
        Type playerType =
            FindType("Player");

        if (playerType == null)
        {
            Logger.LogWarning(
                "Could not find Player type."
            );

            return null;
        }

        FieldInfo localPlayerField =
            playerType.GetField(
                "LocalPlayer",
                BindingFlags.Public |
                BindingFlags.Static
            );

        if (localPlayerField == null)
        {
            Logger.LogWarning(
                "Could not find Player.LocalPlayer."
            );

            return null;
        }

        return localPlayerField.GetValue(null);
    }

    // =========================================================
    // MOVEMENT
    // =========================================================

    private object GetMovement()
    {
        object player =
            GetLocalPlayer();

        if (player == null)
            return null;

        FieldInfo movementField =
            player.GetType().GetField(
                "_movement",
                BindingFlags.NonPublic |
                BindingFlags.Instance
            );

        if (movementField == null)
        {
            Logger.LogWarning(
                "Could not find Player._movement."
            );

            return null;
        }

        return movementField.GetValue(player);
    }

    private void ApplyMovementSpeed()
    {
        object movement =
            GetMovement();

        if (movement == null)
            return;

        Type movementType =
            movement.GetType();

        FieldInfo walkField =
            movementType.GetField(
                "_walkSpeed",
                BindingFlags.NonPublic |
                BindingFlags.Instance
            );

        FieldInfo sprintField =
            movementType.GetField(
                "_sprintSpeed",
                BindingFlags.NonPublic |
                BindingFlags.Instance
            );

        if (walkField == null ||
            sprintField == null)
        {
            Logger.LogWarning(
                "Could not find movement speed fields."
            );

            return;
        }

        if (originalWalkSpeed < 0f)
        {
            object value =
                walkField.GetValue(movement);

            if (value is float)
                originalWalkSpeed = (float)value;
        }

        if (originalSprintSpeed < 0f)
        {
            object value =
                sprintField.GetValue(movement);

            if (value is float)
                originalSprintSpeed = (float)value;
        }

        walkField.SetValue(
            movement,
            originalWalkSpeed *
            walkMultiplier
        );

        sprintField.SetValue(
            movement,
            originalSprintSpeed *
            sprintMultiplier
        );
    }

    private void ResetMovementSpeed()
    {
        object movement =
            GetMovement();

        if (movement == null)
            return;

        Type movementType =
            movement.GetType();

        FieldInfo walkField =
            movementType.GetField(
                "_walkSpeed",
                BindingFlags.NonPublic |
                BindingFlags.Instance
            );

        FieldInfo sprintField =
            movementType.GetField(
                "_sprintSpeed",
                BindingFlags.NonPublic |
                BindingFlags.Instance
            );

        if (walkField != null &&
            originalWalkSpeed >= 0f)
        {
            walkField.SetValue(
                movement,
                originalWalkSpeed
            );
        }

        if (sprintField != null &&
            originalSprintSpeed >= 0f)
        {
            sprintField.SetValue(
                movement,
                originalSprintSpeed
            );
        }

        walkMultiplier = 1.0f;
        sprintMultiplier = 1.0f;

        Logger.LogInfo(
            "Movement speed reset."
        );
    }

    // =========================================================
    // PLAYER POSITION
    // =========================================================

    private Transform GetPlayerTransform()
    {
        object player =
            GetLocalPlayer();

        if (player == null)
            return null;

        Component component =
            player as Component;

        if (component == null)
            return null;

        return component.transform;
    }

    private void SavePlayerPosition()
    {
        Transform playerTransform =
            GetPlayerTransform();

        if (playerTransform == null)
            return;

        savedPosition =
            playerTransform.position;

        hasSavedPosition = true;

        Logger.LogInfo(
            string.Format(
                "Saved position: {0}",
                savedPosition
            )
        );
    }

    private void ReturnToSavedPosition()
    {
        if (!hasSavedPosition)
        {
            Logger.LogWarning(
                "No saved position."
            );

            return;
        }

        Transform playerTransform =
            GetPlayerTransform();

        if (playerTransform == null)
            return;

        playerTransform.position =
            savedPosition;

        Logger.LogInfo(
            string.Format(
                "Returned to position: {0}",
                savedPosition
            )
        );
    }

    // =========================================================
    // FIND TYPES
    // =========================================================

    private Type FindType(string typeName)
    {
        Assembly[] assemblies =
            AppDomain.CurrentDomain.GetAssemblies();

        foreach (Assembly assembly in assemblies)
        {
            try
            {
                Type type =
                    assembly.GetType(typeName);

                if (type != null)
                    return type;
            }
            catch
            {
            }
        }

        foreach (Assembly assembly in assemblies)
        {
            try
            {
                Type[] types =
                    assembly.GetTypes();

                foreach (Type type in types)
                {
                    if (type.Name == typeName)
                        return type;
                }
            }
            catch
            {
            }
        }

        return null;
    }
}
