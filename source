    // =========================================================
    // MISC TAB
    // =========================================================

    private void DrawMiscTab()
    {
        GUILayout.Label("MISC", titleStyle);

        GUILayout.Space(10);

        GUILayout.Label(
            "Miscellaneous features will be added here.",
            labelStyle
        );

        GUILayout.Space(10);

        if (GUILayout.Button(
            "Test Button",
            buttonStyle,
            GUILayout.Width(200)))
        {
            Logger.LogInfo("Misc button pressed.");
        }
    }

    // =========================================================
    // FIND LOCAL PLAYER
    // =========================================================

    private object GetLocalPlayer()
    {
        Type playerType = FindType("Player");

        if (playerType == null)
        {
            Logger.LogWarning(
                "Could not find Player type."
            );

            return null;
        }

        FieldInfo localPlayerField = playerType.GetField(
            "LocalPlayer",
            BindingFlags.Public |
            BindingFlags.Static
        );

        if (localPlayerField == null)
        {
            Logger.LogWarning(
                "Could not find Player.LocalPlayer."
            );

            return null;
        }

        return localPlayerField.GetValue(null);
    }

    // =========================================================
    // FIND PLAYER MOVEMENT
    // =========================================================

    private object GetMovement()
    {
        object player = GetLocalPlayer();

        if (player == null)
            return null;

        FieldInfo movementField = player.GetType().GetField(
            "_movement",
            BindingFlags.NonPublic |
            BindingFlags.Instance
        );

        if (movementField == null)
        {
            Logger.LogWarning(
                "Could not find Player._movement."
            );

            return null;
        }

        return movementField.GetValue(player);
    }

    // =========================================================
    // FIND PLAYER TRANSFORM
    // =========================================================

    private Transform GetPlayerTransform()
    {
        object player = GetLocalPlayer();

        if (player == null)
            return null;

        Component component = player as Component;

        if (component == null)
        {
            Logger.LogWarning(
                "Player is not a Unity Component."
            );

            return null;
        }

        return component.transform;
    }

    // =========================================================
    // APPLY MOVEMENT SPEED
    // =========================================================

    private void ApplyMovementSpeed()
    {
        object movement = GetMovement();

        if (movement == null)
            return;

        Type movementType = movement.GetType();

        FieldInfo walkField = movementType.GetField(
            "_walkSpeed",
            BindingFlags.NonPublic |
            BindingFlags.Instance
        );

        FieldInfo sprintField = movementType.GetField(
            "_sprintSpeed",
            BindingFlags.NonPublic |
            BindingFlags.Instance
        );

        if (walkField == null)
        {
            Logger.LogWarning(
                "Could not find PlayerMovement._walkSpeed."
            );
        }

        if (sprintField == null)
        {
            Logger.LogWarning(
                "Could not find PlayerMovement._sprintSpeed."
            );
        }

        if (walkField == null || sprintField == null)
            return;

        // Get original walk speed
        if (originalWalkSpeed < 0f)
        {
            object value = walkField.GetValue(movement);

            if (value is float)
            {
                originalWalkSpeed = (float)value;
            }
        }

        // Get original sprint speed
        if (originalSprintSpeed < 0f)
        {
            object value = sprintField.GetValue(movement);

            if (value is float)
            {
                originalSprintSpeed = (float)value;
            }
        }

        // Apply walk speed
        walkField.SetValue(
            movement,
            originalWalkSpeed * walkMultiplier
        );

        // Apply sprint speed
        sprintField.SetValue(
            movement,
            originalSprintSpeed * sprintMultiplier
        );
    }

    // =========================================================
    // RESET MOVEMENT SPEED
    // =========================================================

    private void ResetMovementSpeed()
    {
        object movement = GetMovement();

        if (movement == null)
            return;

        Type movementType = movement.GetType();

        FieldInfo walkField = movementType.GetField(
            "_walkSpeed",
            BindingFlags.NonPublic |
            BindingFlags.Instance
        );

        FieldInfo sprintField = movementType.GetField(
            "_sprintSpeed",
            BindingFlags.NonPublic |
            BindingFlags.Instance
        );

        if (walkField != null &&
            originalWalkSpeed >= 0f)
        {
            walkField.SetValue(
                movement,
                originalWalkSpeed
            );
        }

        if (sprintField != null &&
            originalSprintSpeed >= 0f)
        {
            sprintField.SetValue(
                movement,
                originalSprintSpeed
            );
        }

        walkMultiplier = 1.0f;
        sprintMultiplier = 1.0f;

        Logger.LogInfo(
            "Movement speed reset."
        );
    }

    // =========================================================
    // SAVE POSITION
    // =========================================================

    private void SavePlayerPosition()
    {
        Transform playerTransform = GetPlayerTransform();

        if (playerTransform == null)
        {
            Logger.LogWarning(
                "Could not save position: player not found."
            );

            return;
        }

        savedPosition = playerTransform.position;
        hasSavedPosition = true;

        Logger.LogInfo(
            string.Format(
                "Saved player position: {0}",
                savedPosition
            )
        );
    }

    // =========================================================
    // RETURN TO SAVED POSITION
    // =========================================================

    private void ReturnToSavedPosition()
    {
        if (!hasSavedPosition)
        {
            Logger.LogWarning(
                "No saved position."
            );

            return;
        }

        Transform playerTransform = GetPlayerTransform();

        if (playerTransform == null)
        {
            Logger.LogWarning(
                "Could not teleport: player not found."
            );

            return;
        }

        playerTransform.position = savedPosition;

        Logger.LogInfo(
            string.Format(
                "Teleported player to: {0}",
                savedPosition
            )
        );
    }

    // =========================================================
    // FIND TYPE
    // =========================================================

    private Type FindType(string typeName)
    {
        Assembly[] assemblies =
            AppDomain.CurrentDomain.GetAssemblies();

        foreach (Assembly assembly in assemblies)
        {
            try
            {
                Type type = assembly.GetType(typeName);

                if (type != null)
                    return type;
            }
            catch
            {
            }
        }

        foreach (Assembly assembly in assemblies)
        {
            try
            {
                Type[] types = assembly.GetTypes();

                foreach (Type type in types)
                {
                    if (type.Name == typeName)
                        return type;
                }
            }
            catch
            {
            }
        }

        return null;
    }
}
