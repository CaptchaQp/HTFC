[BepInPlugin("com.newmc.howtofishcheat", "HowToFish Cheat", "1.0.0")]
public class Plugin : BaseUnityPlugin
{
    // =========================================================
    // MENU
    // =========================================================

    private bool menuOpen = false;
    private bool stylesCreated = false;

    private Rect windowRect = new Rect(50, 50, 650, 470);

    private int currentTab = 0;

    private readonly string[] tabs =
    {
        "Player",
        "Fishing",
        "Casino",
        "Misc"
    };

    // =========================================================
    // PLAYER
    // =========================================================

    private float walkMultiplier = 1.0f;
    private float sprintMultiplier = 1.0f;

    private float originalWalkSpeed = -1f;
    private float originalSprintSpeed = -1f;

    private Vector3 savedPosition;
    private bool hasSavedPosition = false;

    // =========================================================
    // MONEY
    // =========================================================

    private bool infiniteMoney = false;
    private float moneyTimer = 0f;

    // =========================================================
    // GUI STYLES
    // =========================================================

    private GUIStyle windowStyle;
    private GUIStyle titleStyle;
    private GUIStyle tabStyle;
    private GUIStyle activeTabStyle;
    private GUIStyle headerStyle;
    private GUIStyle labelStyle;
    private GUIStyle valueStyle;
    private GUIStyle buttonStyle;
    private GUIStyle footerStyle;
    private GUIStyle boxStyle;

    // =========================================================
    // START
    // =========================================================

    private void Awake()
    {
        Logger.LogInfo("HowToFish Cheat loaded!");
    }

    // =========================================================
    // UPDATE
    // =========================================================

    private void Update()
    {
        // F2 = open/close menu
        if (Input.GetKeyDown(KeyCode.F2))
        {
            menuOpen = !menuOpen;
        }

        // Infinite money
        if (infiniteMoney)
        {
            moneyTimer += Time.deltaTime;

            if (moneyTimer >= 0.5f)
            {
                moneyTimer = 0f;

                AddMoney(99999);
            }
        }
    }

    // =========================================================
    // GUI
    // =========================================================

    private void OnGUI()
    {
        if (!menuOpen)
            return;

        if (!stylesCreated)
        {
            CreateStyles();
            stylesCreated = true;
        }

        windowRect = GUI.Window(
            12345,
            windowRect,
            DrawWindow,
            "How To Fish Cheat",
            windowStyle
        );
    }

    // =========================================================
    // GUI STYLES
    // =========================================================

    private void CreateStyles()
    {
        windowStyle = new GUIStyle(GUI.skin.window);
        windowStyle.fontSize = 18;
        windowStyle.fontStyle = FontStyle.Bold;
        windowStyle.padding = new RectOffset(12, 12, 35, 12);

        titleStyle = new GUIStyle(GUI.skin.label);
        titleStyle.fontSize = 20;
        titleStyle.fontStyle = FontStyle.Bold;

        tabStyle = new GUIStyle(GUI.skin.button);
        tabStyle.fontSize = 14;
        tabStyle.alignment = TextAnchor.MiddleLeft;
        tabStyle.padding = new RectOffset(15, 8, 8, 8);

        activeTabStyle = new GUIStyle(tabStyle);
        activeTabStyle.fontStyle = FontStyle.Bold;

        headerStyle = new GUIStyle(GUI.skin.label);
        headerStyle.fontSize = 15;
        headerStyle.fontStyle = FontStyle.Bold;

        labelStyle = new GUIStyle(GUI.skin.label);
        labelStyle.fontSize = 13;

        valueStyle = new GUIStyle(GUI.skin.label);
        valueStyle.fontSize = 13;
        valueStyle.fontStyle = FontStyle.Bold;
        valueStyle.alignment = TextAnchor.MiddleRight;

        buttonStyle = new GUIStyle(GUI.skin.button);
        buttonStyle.fontSize = 13;
        buttonStyle.padding = new RectOffset(10, 10, 7, 7);

        footerStyle = new GUIStyle(GUI.skin.label);
        footerStyle.fontSize = 11;
        footerStyle.alignment = TextAnchor.MiddleRight;

        boxStyle = new GUIStyle(GUI.skin.box);
        boxStyle.padding = new RectOffset(12, 12, 10, 10);
    }

    // =========================================================
    // MAIN WINDOW
    // =========================================================

    private void DrawWindow(int windowID)
    {
        GUILayout.BeginHorizontal();

        // LEFT SIDE
        GUILayout.BeginVertical(GUILayout.Width(145));

        GUILayout.Space(5);

        for (int i = 0; i < tabs.Length; i++)
        {
            GUIStyle style =
                currentTab == i
                ? activeTabStyle
                : tabStyle;

            if (GUILayout.Button(
                tabs[i],
                style,
                GUILayout.Height(38)))
            {
                currentTab = i;
            }
        }

        GUILayout.FlexibleSpace();

        GUILayout.Label(
            "F2 - Toggle Menu",
            footerStyle
        );

        GUILayout.EndVertical();

        GUILayout.Space(10);

        // RIGHT SIDE
        GUILayout.BeginVertical(boxStyle);

        switch (currentTab)
        {
            case 0:
                DrawPlayerTab();
                break;

            case 1:
                DrawFishingTab();
                break;

            case 2:
                DrawCasinoTab();
                break;

            case 3:
                DrawMiscTab();
                break;
        }

        GUILayout.EndVertical();

        GUILayout.EndHorizontal();

        // Drag window
        GUI.DragWindow(
            new Rect(0, 0, 650, 35)
        );
    }

    // =========================================================
    // PLAYER TAB
    // =========================================================

    private void DrawPlayerTab()
    {
        GUILayout.Label("PLAYER", titleStyle);

        GUILayout.Space(8);

        // MOVEMENT
        GUILayout.Label(
            "MOVEMENT",
            headerStyle
        );

        GUILayout.BeginHorizontal();

        GUILayout.Label(
            "Walk Speed",
            labelStyle,
            GUILayout.Width(120)
        );

        float newWalkMultiplier =
            GUILayout.HorizontalSlider(
                walkMultiplier,
                0.5f,
                5.0f,
                GUILayout.Width(220)
            );

        GUILayout.Label(
            string.Format(
                "{0:0.0}x",
                newWalkMultiplier
            ),
            valueStyle,
            GUILayout.Width(50)
        );

        GUILayout.EndHorizontal();

        GUILayout.BeginHorizontal();

        GUILayout.Label(
            "Sprint Speed",
            labelStyle,
            GUILayout.Width(120)
        );

        float newSprintMultiplier =
            GUILayout.HorizontalSlider(
                sprintMultiplier,
                0.5f,
                5.0f,
                GUILayout.Width(220)
            );

        GUILayout.Label(
            string.Format(
                "{0:0.0}x",
                newSprintMultiplier
            ),
            valueStyle,
            GUILayout.Width(50)
        );

        GUILayout.EndHorizontal();

        if (Mathf.Abs(
            newWalkMultiplier - walkMultiplier) > 0.001f ||
            Mathf.Abs(
            newSprintMultiplier - sprintMultiplier) > 0.001f)
        {
            walkMultiplier = newWalkMultiplier;
            sprintMultiplier = newSprintMultiplier;

            ApplyMovementSpeed();
        }

        GUILayout.Space(15);

        // RESET
        GUILayout.Label(
            "PLAYER STATE",
            headerStyle
        );

        if (GUILayout.Button(
            "Reset Speed",
            buttonStyle,
            GUILayout.Width(140)))
        {
            ResetMovementSpeed();
        }

        GUILayout.Space(15);

        // POSITION
        GUILayout.Label(
            "POSITION",
            headerStyle
        );

        Transform playerTransform =
            GetPlayerTransform();

        if (playerTransform != null)
        {
            Vector3 position =
                playerTransform.position;

            GUILayout.Label(
                string.Format(
                    "X: {0:0.00}",
                    position.x
                ),
                labelStyle
            );

            GUILayout.Label(
                string.Format(
                    "Y: {0:0.00}",
                    position.y
                ),
                labelStyle
            );

            GUILayout.Label(
                string.Format(
                    "Z: {0:0.00}",
                    position.z
                ),
                labelStyle
            );

            GUILayout.Space(5);

            GUILayout.BeginHorizontal();

            if (GUILayout.Button(
                "Save Position",
                buttonStyle))
            {
                SavePlayerPosition();
            }

            if (GUILayout.Button(
                "Return To Saved",
                buttonStyle))
            {
                ReturnToSavedPosition();
            }

            GUILayout.EndHorizontal();
        }
        else
        {
            GUILayout.Label(
                "Player not found.",
                labelStyle
            );
        }

        GUILayout.Space(15);

        // MONEY
        GUILayout.Label(
            "MONEY",
            headerStyle
        );

        GUILayout.BeginHorizontal();

        if (GUILayout.Button(
            "+ $1,000",
            buttonStyle,
            GUILayout.Width(120)))
        {
            AddMoney(1000);
        }

        if (GUILayout.Button(
            "+ $10,000",
            buttonStyle,
            GUILayout.Width(120)))
        {
            AddMoney(10000);
        }

        if (GUILayout.Button(
            "+ $99,999",
            buttonStyle,
            GUILayout.Width(120)))
        {
            AddMoney(99999);
        }

        GUILayout.EndHorizontal();

        GUILayout.Space(8);

        bool newInfiniteMoney =
            GUILayout.Toggle(
                infiniteMoney,
                "Infinite Money"
            );

        if (newInfiniteMoney != infiniteMoney)
        {
            infiniteMoney = newInfiniteMoney;
            moneyTimer = 0f;
        }
    }

    // =========================================================
    // MONEY
    // =========================================================

    private void AddMoney(int amount)
    {
        object player =
            GetLocalPlayer();

        if (player == null)
        {
            Logger.LogWarning(
                "Cannot add money: local player not found."
            );

            return;
        }

        Type moneyManagerType =
            FindType("MoneyManager");

        if (moneyManagerType == null)
        {
            Logger.LogWarning(
                "Could not find MoneyManager."
            );

            return;
        }

        MethodInfo addMoneyMethod =
            moneyManagerType.GetMethod(
                "AddMoney",
                BindingFlags.Public |
                BindingFlags.Static
            );

        if (addMoneyMethod == null)
        {
            Logger.LogWarning(
                "Could not find MoneyManager.AddMoney."
            );

            return;
        }

        try
        {
            addMoneyMethod.Invoke(
                null,
                new object[]
                {
                    amount,
                    player
                }
            );

            Logger.LogInfo(
                string.Format(
                    "AddMoney called with {0}.",
                    amount
                )
            );
        }
        catch (Exception ex)
        {
            Logger.LogError(
                "AddMoney failed: " +
                ex.Message
            );
        }
    }

